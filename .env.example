# PostgreSQL connection parameters
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=substrate_fetcher

# Database URL for dbmate
DATABASE_URL=postgres://user:password@localhost:5432/substrate_fetcher?sslmode=disable

# IPFS node URL
IPFS_NODE_URL=http://localhost:5001

# Validator settings
KEYSTORE_PATH=/path/to/keystore
VALIDATOR_ACCOUNT_ID=your_validator_account_id
EPOCH_BLOCK_INTERVAL=100

# IPFS timeouts
IPFS_TIMEOUT_SECONDS=10
IPFS_DHT_TIMEOUT_SECONDS=60
IPFS_REFS_TIMEOUT_SECONDS=30
IPFS_FETCH_TIMEOUT=60
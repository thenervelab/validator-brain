CREATE TABLE miners (
    node_id VARCHAR(54) PRIMARY KEY,           -- Node ID (e.g., "12D3KooWA1QSUbJSSYNL...")
    ipfs_storage_max BIGINT,                   -- From ExecutionUnit.NodeMetrics_ALL (e.g., 29100000000000)
    ipfs_zfs_pool_size BIGINT,                 -- From ExecutionUnit.NodeMetrics_ALL (e.g., 31995788368281)
    last_online_block INTEGER,                 -- From ExecutionUnit.BlockNumbers_ALL (e.g., 509400)
    miner_profile_cid VARCHAR(255),            -- From IpfsPallet.MinerProfile_ALL (e.g., "bafkreifankqlgqi77rzsxk4bc5nobfw33lrfbjqrwb5zipozkpfcv7xmkm")
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP  -- Track when the record was last updated
);

CREATE TABLE registration (
    node_id VARCHAR(54) PRIMARY KEY,           -- Node ID (e.g., "12D3KooWA1QSUbJSSYNL...")
    ipfs_node_id VARCHAR(54) NOT NULL,         -- IPFS Node ID (e.g., "12D3KooWNNyXznrESEQUwivscoGKgJZmourVPWhE5SCCAHXWkNdE")
    node_type VARCHAR(50) NOT NULL,            -- Node Type (e.g., "StorageMiner")
    owner VARCHAR(50) NOT NULL,                -- Owner address (e.g., "5F4ViSzuNjhHpDAbohAhjd59jugP52WMMMQ91fNBEZgk4ifr")
    registered_at INTEGER NOT NULL,            -- Registration block number (e.g., 404062)
    status VARCHAR(20) NOT NULL,               -- Status (e.g., "Online")
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP  -- Track when the record was last updated
);
SELECT * FROM user_storage_requests LIMIT 16;



